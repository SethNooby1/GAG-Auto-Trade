Grow A Garden Auto Trade Script

== Config format ==

repeat wait() until game:IsLoaded()
task.wait(10)

getgenv().Configuration = {
    petToGive = {
        "Cockatrice",
        "Dragonfly",
        "Golden Goose",
        "Red Fox",
        "Lobster Thermidor",
        "Griffin"
    },
    targetUsername = "Seth_Nooby1",
    tradeWholeInventory = false, -- true = trade all pets in inventory, false = only trade pets in petToGive list
    whiteScreen = false, -- true = white screen mode, false = normal UI
    leaveWhenDone = false, -- true = leave game when finished, false = stay in game
}
